data/processed/*.jsonl
!data/processed/schema_example.jsonl
data/processed_simple/
data/processed_simple_leaky_backup/
data/processed_ch85heldout/

# llama.cpp 배포 바이너리 (재다운로드 가능, 용량 큼)
